<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:h="clr-namespace:NowBar.App.Helpers">

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>

  <!-- 기본(다크) 팔레트. 실행 시 ThemeService가 설정(테마/투명도/강조색)에 맞게 덮어쓴다. -->
  <SolidColorBrush x:Key="Brush.Island" Color="#F015171C"/>
  <SolidColorBrush x:Key="Brush.Window" Color="#15171C"/>
  <SolidColorBrush x:Key="Brush.Card" Color="#22252D"/>
  <SolidColorBrush x:Key="Brush.Selected" Color="#2A2E38"/>
  <SolidColorBrush x:Key="Brush.Border" Color="#363A45"/>
  <SolidColorBrush x:Key="Brush.Divider" Color="#3A3E4A"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#F2F3F7"/>
  <SolidColorBrush x:Key="Brush.SubText" Color="#969BA8"/>
  <SolidColorBrush x:Key="Brush.Weather" Color="#F4C66A"/>
  <SolidColorBrush x:Key="Brush.Music" Color="#9EB4FF"/>
  <SolidColorBrush x:Key="Brush.AI" Color="#BCA5FF"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="#9EB4FF"/>
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#15171C"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Pressed" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Track" Color="#3A3E4A"/>
  <SolidColorBrush x:Key="Brush.Success" Color="#6FD39A"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="#F4C66A"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="#FF8A8A"/>

  <h:BoolToVisibilityConverter x:Key="BoolToVis"/>
  <h:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
  <h:NullToVisibilityConverter x:Key="NullToVis"/>
  <h:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True"/>
  <h:EnumToBoolConverter x:Key="EnumToBool"/>

  <!-- ── 텍스트 ───────────────────────────────────────── -->
  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Text.Strong" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Text.Sub" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Sub}">
    <Setter Property="FontSize" Value="11.5"/>
  </Style>
  <Style x:Key="Text.Big" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="40"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="TextTrimming" Value="None"/>
  </Style>
  <Style x:Key="Text.TabName" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="None"/>
  </Style>
  <Style x:Key="Text.TabStatus" TargetType="TextBlock" BasedOn="{StaticResource Text.Sub}">
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
  <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,18,0,8"/>
  </Style>

  <!-- ── 버튼 ─────────────────────────────────────────── -->
  <Style x:Key="Button.Bare" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Bare}">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
  </Style>

  <Style x:Key="Button.Media" TargetType="Button" BasedOn="{StaticResource Button.Bare}">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="36"/>
  </Style>

  <Style x:Key="Button.Pill" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
            <Grid>
              <Border x:Name="Overlay" Background="Transparent" CornerRadius="8"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Pill}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 상단 탭 버튼: Tag=true 이면 선택 상태. BorderBrush = 탭 강조색(하단 표시줄) -->
  <Style x:Key="Button.Tab" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Margin="2,6" ClipToBounds="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
              <Border x:Name="Indicator" Height="2" Width="16" CornerRadius="1" VerticalAlignment="Bottom"
                      Margin="0,0,0,2" Background="{TemplateBinding BorderBrush}" Opacity="0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}"/>
              <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 세션 선택용 작은 칩 버튼: Tag=true 이면 선택 -->
  <Style x:Key="Button.Chip" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="10" Padding="9,2">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── 카드 ─────────────────────────────────────────── -->
  <Style x:Key="Card.Stat" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="3,0"/>
  </Style>

  <!-- ── 슬라이더 ─────────────────────────────────────── -->
  <Style x:Key="Repeat.Fill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Repeat.Empty" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Slider.Thumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource Brush.Text}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="Width" Value="14"/>
              <Setter TargetName="Dot" Property="Height" Value="14"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Slider.NowBar" TargetType="Slider">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="18" Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Track}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Repeat.Fill}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Repeat.Empty}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Slider.Thumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── 설정 창 입력 컨트롤 ───────────────────────────── -->
  <Style x:Key="Input.Text" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Input.Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,5"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Input.Radio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
</ResourceDictionary>
