<UserControl x:Class="NowBar.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NowBar.App.Controls">
  <UserControl.Resources>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="Margin" Value="0,6,12,6"/>
      <Setter Property="Width" Value="170"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Sub}">
      <Setter Property="Width" Value="60"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,6,22,22">
    <StackPanel>

      <!-- ── 일반 ── -->
      <TextBlock Text="일반" Style="{StaticResource Text.Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox Content="Windows 시작 시 자동 실행" IsChecked="{Binding Settings.StartWithWindows}" Style="{StaticResource Input.Check}"/>
          <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Text.Caption}" Margin="22,0,0,6"/>
          <CheckBox Content="마우스를 올리면 자동으로 확장" IsChecked="{Binding Settings.AutoExpand}" Style="{StaticResource Input.Check}"/>
          <CheckBox Content="항상 위에 표시" IsChecked="{Binding Settings.AlwaysOnTop}" Style="{StaticResource Input.Check}"/>
          <CheckBox Content="전체 화면 앱(게임·발표)이 실행 중이면 숨기기" IsChecked="{Binding Settings.HideInFullscreen}" Style="{StaticResource Input.Check}"/>

          <DockPanel Style="{StaticResource Row}" Margin="0,10,0,2">
            <TextBlock Text="자동 축소 지연" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.CollapseDelayMs, StringFormat={}{0} ms}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="200" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.CollapseDelayMs}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="상단 여백" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.TopOffset, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.TopOffset}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="가로 위치 (중앙 기준)" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.HorizontalOffset, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="-600" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.HorizontalOffset}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="축소 시 너비" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.CompactWidth, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="160" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.CompactWidth}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="캡슐 높이" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.CapsuleHeight, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="40" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.CapsuleHeight}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="확장 패널 너비" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.ExpandedWidth, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="440" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.ExpandedWidth}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="확장 패널 높이" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.ExpandedHeight, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="220" Maximum="340" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.ExpandedHeight}" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
            <Button Content="크기·위치 기본값으로" Style="{StaticResource Button.Pill}" Command="{Binding ResetLayoutCommand}"/>
            <Button Content="데이터 폴더 열기" Style="{StaticResource Button.Pill}" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── 디자인 ── -->
      <TextBlock Text="디자인" Style="{StaticResource Text.Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="테마" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Content="다크 모드" GroupName="Theme" Style="{StaticResource Input.Radio}"
                           IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}"/>
              <RadioButton Content="밝은 모드" GroupName="Theme" Style="{StaticResource Input.Radio}"
                           IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="배경 불투명도" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.BackgroundOpacity, StringFormat={}{0:P0}}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="0.5" Maximum="1" TickFrequency="0.02" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.BackgroundOpacity}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="모서리 둥글기" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.CornerRadius, StringFormat={}{0:0} px}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="8" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.CornerRadius}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="애니메이션 속도" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.AnimationMs, StringFormat={}{0} ms}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="80" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.AnimationMs}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="강조 색상" Style="{StaticResource Label}"/>
            <TextBox DockPanel.Dock="Right" Width="90" Style="{StaticResource Input.Text}"
                     Text="{Binding Settings.AccentColor, UpdateSourceTrigger=LostFocus}"/>
            <ItemsControl ItemsSource="{Binding AccentPresets}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Button.Bare}" Width="26" Height="26" Margin="0,0,4,0" ToolTip="{Binding}"
                          Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <Ellipse Width="16" Height="16" Fill="{Binding}" Stroke="{DynamicResource Brush.Border}"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- ── 날씨 ── -->
      <TextBlock Text="날씨" Style="{StaticResource Text.Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="현재 지역" Style="{StaticResource Label}"/>
            <Button DockPanel.Dock="Right" Content="지우기" Style="{StaticResource Button.Pill}" Command="{Binding ClearLocationCommand}"/>
            <TextBlock Text="{Binding CurrentLocationText}" Style="{StaticResource Text.Strong}"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}" Margin="0,8,0,2">
            <Button DockPanel.Dock="Right" Content="검색" Style="{StaticResource Button.Primary}" Command="{Binding SearchLocationCommand}"
                    Margin="8,0,0,0" IsDefault="False"/>
            <TextBox x:Name="LocationBox" Style="{StaticResource Input.Text}" Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="LocationBox_KeyDown"/>
          </DockPanel>
          <TextBlock Text="{Binding LocationStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,4"
                     Visibility="{Binding LocationStatus, Converter={StaticResource NullToVis}}"/>
          <ListBox ItemsSource="{Binding LocationResults}" SelectedItem="{Binding SelectedResult}" MaxHeight="160"
                   Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Text}"
                   Visibility="{Binding LocationResults.Count, Converter={StaticResource NullToVis}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="2,3">
                  <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Base}"/>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="10,0,0,0">
                    <Run Text="{Binding Latitude, StringFormat={}{0:0.00}}"/>, <Run Text="{Binding Longitude, StringFormat={}{0:0.00}}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Style="{StaticResource Row}" Margin="0,10,0,2">
            <TextBlock Text="온도 단위" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Content="섭씨 (°C)" GroupName="Unit" Style="{StaticResource Input.Radio}"
                           IsChecked="{Binding Settings.TemperatureUnit, Converter={StaticResource EnumToBool}, ConverterParameter=Celsius}"/>
              <RadioButton Content="화씨 (°F)" GroupName="Unit" Style="{StaticResource Input.Radio}"
                           IsChecked="{Binding Settings.TemperatureUnit, Converter={StaticResource EnumToBool}, ConverterParameter=Fahrenheit}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="업데이트 주기" Style="{StaticResource Label}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.WeatherRefreshMinutes, StringFormat={}{0}분}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="10" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.WeatherRefreshMinutes}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="데이터: Open-Meteo (API 키 불필요). 위치는 자동으로 수집하지 않습니다." Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- ── 음악 ── -->
      <TextBlock Text="음악" Style="{StaticResource Text.Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox Content="Windows가 지정한 현재 미디어 세션을 자동 선택" IsChecked="{Binding Settings.AutoSelectMediaSession}" Style="{StaticResource Input.Check}"/>
          <CheckBox Content="여러 프로그램이 재생 중이면 세션 선택 버튼 표시" IsChecked="{Binding Settings.AllowSessionPicker}" Style="{StaticResource Input.Check}"/>
          <CheckBox Content="앨범 이미지 / 동영상 썸네일 표시" IsChecked="{Binding Settings.ShowAlbumArt}" Style="{StaticResource Input.Check}"/>
          <TextBlock Text="Windows 시스템 미디어 세션(GSMTC)을 제공하는 프로그램만 표시·제어할 수 있습니다." Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- ── AI 작업 (Claude Code) ── -->
      <TextBlock Text="AI 작업 (Claude Code)" Style="{StaticResource Text.Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="연결 상태" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding AI.ConnectionText}" Style="{StaticResource Text.Strong}" TextWrapping="Wrap" TextTrimming="None"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="수신 주소" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding HookUrl}" Style="{StaticResource Text.Sub}"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="인증 토큰" Style="{StaticResource Label}"/>
            <Button DockPanel.Dock="Right" Content="토큰 재생성" Style="{StaticResource Button.Pill}" Command="{Binding RegenerateTokenCommand}"/>
            <TextBlock Text="{Binding MaskedToken}" Style="{StaticResource Text.Sub}"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="포트" Style="{StaticResource Label}"/>
            <Button DockPanel.Dock="Right" Content="적용" Style="{StaticResource Button.Pill}" Command="{Binding ApplyPortCommand}"/>
            <TextBox Width="90" HorizontalAlignment="Left" Style="{StaticResource Input.Text}" Text="{Binding HookPortText, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="Claude 설정 파일" Style="{StaticResource Label}"/>
            <Button DockPanel.Dock="Right" Content="폴더 열기" Style="{StaticResource Button.Pill}" Command="{Binding OpenClaudeFolderCommand}"/>
            <TextBlock Text="{Binding ClaudeSettingsPath}" Style="{StaticResource Text.Sub}" ToolTip="{Binding ClaudeSettingsPath}"/>
          </DockPanel>

          <WrapPanel Margin="0,10,0,4">
            <Button Content="Claude Code 연동 설정" Style="{StaticResource Button.Primary}" Command="{Binding RunClaudeSetupCommand}" Margin="0,0,8,6"/>
            <Button Content="연동 테스트" Style="{StaticResource Button.Pill}" Command="{Binding TestConnectionCommand}" Margin="0,0,8,6"/>
            <Button Content="연결 해제" Style="{StaticResource Button.Pill}" Command="{Binding DisconnectClaudeCommand}" Margin="0,0,8,6"/>
            <Button Content="수동 설정용 JSON 복사" Style="{StaticResource Button.Pill}" Command="{Binding CopyManualJsonCommand}" Margin="0,0,8,6"/>
          </WrapPanel>

          <Border Background="{DynamicResource Brush.Window}" CornerRadius="8" Padding="10,8" Margin="0,2,0,6"
                  Visibility="{Binding SetupLog.Count, Converter={StaticResource NullToVis}}">
            <ItemsControl ItemsSource="{Binding SetupLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <CheckBox Content="Claude Code 연동 사용 (로컬 서버 실행)" IsChecked="{Binding Settings.ClaudeIntegrationEnabled}" Style="{StaticResource Input.Check}"/>
          <CheckBox Content="작업 요약 표시 (프롬프트 앞부분을 짧게 표시 · 메모리에만 보관)" IsChecked="{Binding Settings.ShowTaskSummary}" Style="{StaticResource Input.Check}"/>
          <DockPanel Style="{StaticResource Row}" Margin="22,0,0,2"
                     Visibility="{Binding Settings.ShowTaskSummary, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="요약 최대 길이" Style="{StaticResource Label}" Width="148"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.SummaryMaxLength, StringFormat={}{0}자}" Style="{StaticResource Value}"/>
            <Slider Style="{StaticResource Slider.NowBar}" Minimum="10" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding Settings.SummaryMaxLength}" VerticalAlignment="Center"/>
          </DockPanel>
          <CheckBox Content="Claude 알림 표시" IsChecked="{Binding Settings.ShowNotifications}" Style="{StaticResource Input.Check}"/>
          <CheckBox Content="여러 세션 구분 표시" IsChecked="{Binding Settings.ShowSessions}" Style="{StaticResource Input.Check}"/>
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                     Text="Claude Code가 공식 제공하는 Hooks 이벤트만 수신합니다. 대화 내용·명령어·환경 변수는 저장하거나 외부로 전송하지 않으며, 서버는 127.0.0.1에서만 접속을 받습니다."/>
        </StackPanel>
      </Border>

      <!-- ── 수동 작업 등록 ── -->
      <TextBlock Text="수동 작업 등록" Style="{StaticResource Text.Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"
                     Text="Hooks를 사용할 수 없는 환경에서는 작업을 직접 등록해 AI 작업 탭에 표시할 수 있습니다."/>
          <DockPanel Style="{StaticResource Row}">
            <Button DockPanel.Dock="Right" Content="작업 시작" Style="{StaticResource Button.Primary}" Command="{Binding StartManualTaskCommand}" Margin="8,0,0,0"/>
            <TextBox Style="{StaticResource Input.Text}" Text="{Binding ManualTaskName, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,2" Visibility="{Binding AI.HasManualTask, Converter={StaticResource BoolToVis}}">
            <Button Content="완료로 표시" Style="{StaticResource Button.Pill}" Command="{Binding CompleteManualTaskCommand}"/>
            <Button Content="지우기" Style="{StaticResource Button.Pill}" Command="{Binding ClearManualTaskCommand}" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="NowBar 1.0 · 트레이 아이콘에서 종료할 수 있습니다." Style="{StaticResource Text.Caption}" Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
