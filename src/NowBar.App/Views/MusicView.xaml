<UserControl x:Class="NowBar.App.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NowBar.App.Controls">
  <Grid Margin="18,12,18,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 상단: 재생 프로그램 + 상태 -->
    <StackPanel Orientation="Horizontal" Margin="0,2,76,0">
      <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Strong}" MaxWidth="200"
                 Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="Windows 미디어" Style="{StaticResource Text.Strong}"
                 Visibility="{Binding HasSession, Converter={StaticResource InvBoolToVis}}"/>
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Sub}" Margin="10,0,0,0"/>
    </StackPanel>

    <!-- 세션 선택 (여러 프로그램이 세션을 제공할 때) -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Sessions}" Margin="0,8,0,0"
                  Visibility="{Binding ShowSessionPicker, Converter={StaticResource BoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource Button.Chip}" Tag="{Binding IsSelected}" Content="{Binding AppName}"
                  Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 재생 없음 / 정보 없음 -->
    <StackPanel Grid.Row="2" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
      <c:Icon Kind="Music" Width="28" Height="28" Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Base}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <TextBlock Text="Windows 미디어 세션을 제공하는 프로그램(Spotify, 미디어 플레이어, 브라우저 등)이 표시됩니다."
                 Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- 곡 정보 -->
    <Grid Grid.Row="2" VerticalAlignment="Center" Margin="0,6,0,0"
          Visibility="{Binding Message, Converter={StaticResource InvNullToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="60" Height="60" CornerRadius="10" Background="{DynamicResource Brush.Card}" Margin="0,0,14,0">
        <Grid>
          <c:Icon Kind="Music" Width="24" Height="24" Foreground="{DynamicResource Brush.Music}"
                  Visibility="{Binding ShowThumbnail, Converter={StaticResource InvBoolToVis}}"/>
          <Border CornerRadius="10" Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}">
            <Border.Background>
              <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
            </Border.Background>
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource Text.Strong}" FontSize="15" ToolTip="{Binding DisplayTitle}"/>
        <TextBlock Text="{Binding DisplayArtist}" Style="{StaticResource Text.Sub}" FontSize="13" Margin="0,3,0,0"/>
        <TextBlock Text="{Binding CommandError}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}"
                   Margin="0,3,0,0" Visibility="{Binding CommandError, Converter={StaticResource NullToVis}}"/>
      </StackPanel>
    </Grid>

    <!-- 진행률 / 재생 위치 조절 -->
    <Grid Grid.Row="3" Margin="0,6,0,0" Visibility="{Binding Message, Converter={StaticResource InvNullToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="44"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding PositionText}" Style="{StaticResource Text.Caption}"/>
      <Slider x:Name="SeekSlider" AutomationProperties.Name="재생 위치" Grid.Column="1" Style="{StaticResource Slider.NowBar}"
              Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding SliderPosition, Mode=TwoWay}"
              IsEnabled="{Binding CanSeek}"
              PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
              LostMouseCapture="SeekSlider_LostMouseCapture"/>
      <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
    </Grid>

    <!-- 제어 버튼 -->
    <Grid Grid.Row="4" Margin="0,2,0,0" Visibility="{Binding Message, Converter={StaticResource InvNullToVis}}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Style="{StaticResource Button.Media}" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip="이전 곡" AutomationProperties.Name="이전 곡">
          <c:Icon Kind="SkipBack" Width="18" Height="18" Filled="True" Foreground="{DynamicResource Brush.Text}"/>
        </Button>
        <Button Style="{StaticResource Button.Media}" Width="48" Margin="10,0" Command="{Binding PlayPauseCommand}"
                IsEnabled="{Binding CanPlayPause}" ToolTip="재생 / 일시정지" AutomationProperties.Name="재생 / 일시정지">
          <c:Icon Kind="{Binding PlayPauseIcon}" Width="22" Height="22" Filled="True" Foreground="{DynamicResource Brush.Text}"/>
        </Button>
        <Button Style="{StaticResource Button.Media}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip="다음 곡" AutomationProperties.Name="다음 곡">
          <c:Icon Kind="SkipForward" Width="18" Height="18" Filled="True" Foreground="{DynamicResource Brush.Text}"/>
        </Button>
      </StackPanel>
      <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding OpenSourceAppCommand}"
              ToolTip="재생 프로그램 열기" AutomationProperties.Name="재생 프로그램 열기">
        <c:Icon Kind="ExternalLink" Width="16" Height="16" Foreground="{DynamicResource Brush.SubText}"/>
      </Button>
    </Grid>
  </Grid>
</UserControl>
