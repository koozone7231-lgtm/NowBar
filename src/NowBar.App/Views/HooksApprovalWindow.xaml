<Window x:Class="NowBar.App.Views.HooksApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code 설정 변경 확인"
        Width="620" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource UiFont}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Strong}" FontSize="16"/>
      <TextBlock x:Name="PathText" Style="{StaticResource Text.Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
      <TextBlock Style="{StaticResource Text.Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                 Text="기존 설정과 다른 Hooks는 그대로 유지되며, 저장 전에 원본 파일을 백업합니다."/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <TextBlock Text="변경 사항" Style="{StaticResource Text.Strong}"/>
      <ItemsControl x:Name="ChangesList" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Text.Base}" Margin="0,1"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ItemsControl x:Name="WarningsList" Grid.Row="2" Margin="0,10,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding StringFormat=⚠ {0}}" Style="{StaticResource Text.Base}" Foreground="{DynamicResource Brush.Warning}"
                     TextWrapping="Wrap" TextTrimming="None" Margin="0,1"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock DockPanel.Dock="Top" Text="저장 후 hooks 항목 (토큰은 가려서 표시)" Style="{StaticResource Text.Strong}" Margin="0,0,0,6"/>
      <TextBox x:Name="PreviewBox" IsReadOnly="True" Style="{StaticResource Input.Text}" FontFamily="Consolas" FontSize="12"
               VerticalContentAlignment="Top" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="취소" Style="{StaticResource Button.Pill}" IsCancel="True" Click="Cancel_Click" MinWidth="80"/>
      <Button x:Name="ApplyButton" Content="승인하고 저장" Style="{StaticResource Button.Primary}" Click="Apply_Click" Margin="8,0,0,0" MinWidth="120"/>
    </StackPanel>
  </Grid>
</Window>
