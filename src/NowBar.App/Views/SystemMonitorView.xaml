<!--
  시스템 모니터 (2줄, 빠른 설정과 같은 카드 크기)
  1줄: CPU · 메모리 — 현재 %와 최근 60초 그래프
  2줄: 디스크(시스템 드라이브) · 네트워크(↓ ↑) · CPU를 많이 쓰는 앱 2개
-->
<UserControl x:Class="NowBar.App.Views.SystemMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NowBar.App.Controls">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="Margin" Value="4,0"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 얇은 막대 (디스크 사용량) -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Brush.Track}"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <UniformGrid Columns="2" Margin="-4,0">
      <Border Style="{StaticResource Card}" ToolTip="최근 60초 CPU 사용률">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" Style="{StaticResource Value}"/>
            <c:Icon Kind="Cpu" Width="15" Height="15" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="CPU" Margin="6,0,0,0" Style="{StaticResource Label}"/>
          </DockPanel>
          <c:Sparkline Values="{Binding CpuHistory}" Stroke="{DynamicResource Brush.Accent}" Height="22" VerticalAlignment="Bottom"/>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}" ToolTip="최근 60초 메모리 사용률">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" Style="{StaticResource Value}"/>
            <c:Icon Kind="Memory" Width="15" Height="15" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="메모리" Margin="6,0,0,0" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding MemoryDetail}" Margin="8,0,6,0" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <c:Sparkline Values="{Binding MemoryHistory}" Stroke="{DynamicResource Brush.Info}" Height="22" VerticalAlignment="Bottom"/>
        </DockPanel>
      </Border>
    </UniformGrid>

    <Grid Margin="-4,8,-4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.3*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" ToolTip="Windows가 설치된 드라이브 사용량">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DiskText}" Style="{StaticResource Value}"/>
            <c:Icon Kind="HardDrive" Width="15" Height="15" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="{Binding DiskName}" Margin="6,0,0,0" Style="{StaticResource Label}"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding DiskDetail}" Style="{StaticResource Small}"/>
          <ProgressBar Style="{StaticResource Bar}" Value="{Binding DiskPercent, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" ToolTip="모든 네트워크 어댑터의 초당 받기 / 보내기">
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <c:Icon Kind="ArrowDown" Width="14" Height="14" Foreground="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{Binding DownText}" Margin="6,0,0,0" Style="{StaticResource Value}" FontSize="12"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <c:Icon Kind="ArrowUp" Width="14" Height="14" Foreground="{DynamicResource Brush.Info}"/>
            <TextBlock Text="{Binding UpText}" Margin="6,0,0,0" Style="{StaticResource Value}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" ToolTip="최근 2초 동안 CPU를 많이 쓴 앱 (같은 이름은 합산)">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="많이 쓰는 앱" Style="{StaticResource Small}" Margin="0,0,0,3"/>
          <TextBlock Text="조용합니다" Style="{StaticResource Small}" VerticalAlignment="Top"
                     Visibility="{Binding HasTopApps, Converter={StaticResource InvBoolToVis}}"/>
          <ItemsControl ItemsSource="{Binding TopApps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Height="17">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CpuPercent, StringFormat={}{0:0.#}%}" Style="{StaticResource Small}" Foreground="{DynamicResource Brush.Text}"/>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="12" Margin="0,0,6,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
