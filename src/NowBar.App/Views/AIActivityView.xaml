<UserControl x:Class="NowBar.App.Views.AIActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NowBar.App.Controls"
             xmlns:m="clr-namespace:NowBar.App.Models">
  <UserControl.Resources>
    <!-- 상태별 색상 -->
    <Style x:Key="StateBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9,2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubText}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static m:ClaudeTaskState.Working}">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static m:ClaudeTaskState.ToolRunning}">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static m:ClaudeTaskState.Waiting}">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static m:ClaudeTaskState.Completed}">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static m:ClaudeTaskState.Error}">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="18,12,18,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 상단: Claude Code 연결 상태 -->
    <StackPanel Orientation="Horizontal" Margin="0,2,76,0">
      <TextBlock Text="Claude Code" Style="{StaticResource Text.Strong}"/>
      <Ellipse Width="7" Height="7" Margin="10,0,6,0" VerticalAlignment="Center">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Brush.SubText}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Text.Sub}" MaxWidth="260" ToolTip="{Binding ConnectionText}"/>
    </StackPanel>

    <!-- 세션 구분 (여러 Claude Code 세션) -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Sessions}" Margin="0,8,0,0"
                  Visibility="{Binding ShowSessionChips, Converter={StaticResource BoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource Button.Chip}" Tag="{Binding IsSelected}"
                  Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}" ToolTip="{Binding StateText}">
            <TextBlock Text="{Binding ProjectName}" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 작업 없음 -->
    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding HasSessions, Converter={StaticResource InvBoolToVis}}">
      <c:Icon Kind="Sparkles" Width="28" Height="28" Foreground="{DynamicResource Brush.AI}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Base}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <Button Content="연동 설정 열기" Style="{StaticResource Button.Pill}" Command="{Binding OpenSettingsCommand}"
              HorizontalAlignment="Center" Margin="0,10,0,0"
              Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}"/>
    </StackPanel>

    <!-- 선택된 세션 상세 -->
    <Grid Grid.Row="2" Margin="0,10,0,0" DataContext="{Binding SelectedSession}"
          Visibility="{Binding Converter={StaticResource NullToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 프로젝트 + 상태 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <c:Icon Kind="Folder" Width="14" Height="14" Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Text.Strong}" FontSize="15" Margin="7,0,0,0" MaxWidth="300"
                     ToolTip="{Binding Session.Cwd}"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource StateBadge}">
          <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Base}" FontSize="12"/>
        </Border>
      </Grid>

      <!-- 현재 작업 요약 (동의한 경우만) -->
      <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Style="{StaticResource Text.Base}" Margin="0,8,0,0"
                 ToolTip="{Binding SummaryText}" Visibility="{Binding SummaryText, Converter={StaticResource NullToVis}}"/>

      <!-- 최근 활동 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
        <c:Icon Kind="Activity" Width="14" Height="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ActivityText}" Style="{StaticResource Text.Base}" Margin="7,0,0,0" MaxWidth="400"/>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Style="{StaticResource Text.Sub}" Foreground="{DynamicResource Brush.Danger}"
                 HorizontalAlignment="Right" Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" Margin="0,8,0,0"/>

      <!-- 시작/경과 시간 -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
        <c:Icon Kind="Clock" Width="14" Height="14" Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StartedText}" Style="{StaticResource Text.Sub}" Margin="7,0,0,0"/>
        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Text.Sub}" Margin="10,0,0,0"/>
        <TextBlock Text="{Binding LastEventText}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0"/>
      </StackPanel>

      <!-- 최근 알림 / 오래된 상태 안내 -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0"
                  Visibility="{Binding NotificationText, Converter={StaticResource NullToVis}}">
        <c:Icon Kind="Bell" Width="14" Height="14" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding NotificationText}" Style="{StaticResource Text.Sub}" Margin="7,0,0,0" MaxWidth="400"
                   ToolTip="{Binding NotificationText}"/>
      </StackPanel>
      <TextBlock Grid.Row="4" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Warning}"
                 Text="10분 넘게 이벤트가 없습니다. 작업을 중단(Esc)하면 완료 이벤트가 오지 않을 수 있습니다."
                 Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}"/>
    </Grid>
  </Grid>
</UserControl>
