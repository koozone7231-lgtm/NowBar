<Window x:Class="NowBar.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:NowBar.App.Views"
        Title="NowBar 설정"
        Width="640" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Resources/Icons/nowbar.ico">
  <DockPanel>
    <!-- 하단 저장 바 -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0" Padding="22,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="되돌리기" Style="{StaticResource Button.Pill}" Command="{Binding RevertCommand}"
                  ToolTip="마지막으로 저장한 설정으로 되돌립니다"/>
          <Button Content="저장" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                  ToolTip="설정 저장 (Ctrl+S)" Margin="8,0,0,0" MinWidth="90"/>
        </StackPanel>
        <TextBlock Text="{Binding SaveStatusText}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Sub}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Border>
    <v:SettingsView/>
  </DockPanel>
</Window>
