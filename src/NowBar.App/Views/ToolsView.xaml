<!--
  도구 탭: 위쪽 섹션 칩 (빠른 설정 · 볼륨 믹서 — 클립보드·시스템이 칩으로 추가될 자리)
  그 아래에 선택한 도구를 보여준다.
-->
<UserControl x:Class="NowBar.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NowBar.App.Views"
             xmlns:vm="clr-namespace:NowBar.App.ViewModels">
  <Grid Margin="18,12,18,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 섹션 칩 (오른쪽은 상태 아이콘·고정·설정 자리) -->
    <StackPanel Orientation="Horizontal" Margin="0,2,150,0" VerticalAlignment="Center">
      <Button Content="빠른 설정" Style="{StaticResource Button.Chip}" Tag="{Binding IsQuickSettingsSection}"
              Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:ToolsSection.QuickSettings}"/>
      <Button Content="볼륨 믹서" Style="{StaticResource Button.Chip}" Tag="{Binding IsMixerSection}"
              Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:ToolsSection.Mixer}"/>
    </StackPanel>

    <v:QuickSettingsView Grid.Row="1" Margin="0,10,0,0" DataContext="{Binding QuickSettings}"
                         Visibility="{Binding DataContext.IsQuickSettingsSection, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVis}}"/>

    <v:AudioMixerView Grid.Row="1" Margin="0,10,0,0" DataContext="{Binding Mixer}"
                      Visibility="{Binding DataContext.IsMixerSection, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVis}}"/>
  </Grid>
</UserControl>
