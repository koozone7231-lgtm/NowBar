<!--
  빠른 설정 2줄 타일
  1줄: Wi-Fi · 블루투스 · 마이크(켜짐/음소거) · 다크 모드 (켜기/끄기)
  2줄: 전원 모드 · 밝기(지원 안 하면 볼륨, 2칸) · 잠금
  켜진 타일은 강조색 배경 + 검정 글자.
-->
<UserControl x:Class="NowBar.App.Views.QuickSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:c="clr-namespace:NowBar.App.Controls">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}"/>
              </Trigger>
              <Trigger Property="Tag">
                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 타일 안 글자: 버튼 글자색을 그대로 따라가도록 색을 지정하지 않는다 -->
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TileState" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <UniformGrid Columns="4" Margin="-4,0">
      <Button Style="{StaticResource Tile}" Margin="4,0" Tag="{Binding WifiOn}" IsEnabled="{Binding WifiAvailable}"
              Command="{Binding ToggleWifiCommand}" AutomationProperties.Name="Wi-Fi" ToolTip="Wi-Fi 켜기/끄기">
        <DockPanel>
          <c:Icon DockPanel.Dock="Top" Kind="Wifi" Width="17" Height="17" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="Wi-Fi" Style="{StaticResource TileLabel}"/>
            <TextBlock Text="{Binding WifiText}" Style="{StaticResource TileState}"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource Tile}" Margin="4,0" Tag="{Binding BluetoothOn}" IsEnabled="{Binding BluetoothAvailable}"
              Command="{Binding ToggleBluetoothCommand}" AutomationProperties.Name="블루투스" ToolTip="블루투스 켜기/끄기">
        <DockPanel>
          <c:Icon DockPanel.Dock="Top" Kind="Bluetooth" Width="17" Height="17" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="블루투스" Style="{StaticResource TileLabel}"/>
            <TextBlock Text="{Binding BluetoothText}" Style="{StaticResource TileState}"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource Tile}" Margin="4,0" Tag="{Binding MicOn}" IsEnabled="{Binding MicAvailable}"
              Command="{Binding ToggleMicCommand}" AutomationProperties.Name="마이크" ToolTip="마이크 켜기 / 음소거">
        <DockPanel>
          <c:Icon DockPanel.Dock="Top" Kind="{Binding MicIcon}" Width="17" Height="17" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="마이크" Style="{StaticResource TileLabel}"/>
            <TextBlock Text="{Binding MicText}" Style="{StaticResource TileState}"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource Tile}" Margin="4,0" Tag="{Binding DarkMode}"
              Command="{Binding ToggleDarkModeCommand}" AutomationProperties.Name="다크 모드" ToolTip="Windows 다크 모드 켜기/끄기">
        <DockPanel>
          <c:Icon DockPanel.Dock="Top" Kind="Moon" Width="17" Height="17" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="다크 모드" Style="{StaticResource TileLabel}"/>
            <TextBlock Text="{Binding DarkText}" Style="{StaticResource TileState}"/>
          </StackPanel>
        </DockPanel>
      </Button>
    </UniformGrid>

    <Grid Margin="-4,8,-4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource Tile}" Margin="4,0" Tag="{Binding PowerIsPerformance}" IsEnabled="{Binding PowerAvailable}"
              Command="{Binding CyclePowerModeCommand}" AutomationProperties.Name="전원 모드" ToolTip="누를 때마다 효율 → 균형 → 성능">
        <DockPanel>
          <c:Icon DockPanel.Dock="Top" Kind="Bolt" Width="17" Height="17" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="전원 모드" Style="{StaticResource TileLabel}"/>
            <TextBlock Text="{Binding PowerText}" Style="{StaticResource TileState}"/>
          </StackPanel>
        </DockPanel>
      </Button>

      <!-- 밝기 (내장 디스플레이) / 지원 안 하면 볼륨 -->
      <Border Grid.Column="1" Margin="4,0" Height="64" CornerRadius="8" Padding="12,8" Background="{DynamicResource Brush.Surface}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding SliderText}" FontSize="11" Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center"/>
            <c:Icon Kind="{Binding SliderIcon}" Width="17" Height="17" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="{Binding SliderLabel}" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
          </DockPanel>
          <Slider Style="{StaticResource Slider.NowBar}" Minimum="0" Maximum="100" VerticalAlignment="Bottom"
                  Value="{Binding SliderValue}" AutomationProperties.Name="{Binding SliderLabel}"/>
        </DockPanel>
      </Border>

      <Button Grid.Column="2" Style="{StaticResource Tile}" Margin="4,0" Command="{Binding LockCommand}"
              AutomationProperties.Name="화면 잠금" ToolTip="지금 화면 잠금 (Win+L)">
        <DockPanel>
          <c:Icon DockPanel.Dock="Top" Kind="Lock" Width="17" Height="17" HorizontalAlignment="Left"/>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock Text="잠금" Style="{StaticResource TileLabel}"/>
            <TextBlock Text="바로 잠금" Style="{StaticResource TileState}"/>
          </StackPanel>
        </DockPanel>
      </Button>
    </Grid>

    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}"
               TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
               Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>
  </StackPanel>
</UserControl>
