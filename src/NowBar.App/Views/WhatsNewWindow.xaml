<!--
  업데이트 직후 "새로 바뀐 점" 팝업. NowBar 캡슐 바로 아래 가운데에 뜨는 어두운 카드.
  내용은 앱에 들어 있는 CHANGELOG.md에서 읽는다 (인터넷 불필요).
-->
<Window x:Class="NowBar.App.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NowBar.App.Controls"
        Title="NowBar 업데이트 내용"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">
  <Border Margin="16" CornerRadius="16" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
    </Border.Effect>
    <Grid Margin="20,18,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="26" Height="26" Click="Close_Click"
                AutomationProperties.Name="닫기" ToolTip="닫기" VerticalAlignment="Top">
          <c:Icon Kind="X" Width="14" Height="14" Foreground="{DynamicResource Brush.SubText}"/>
        </Button>
        <c:Icon Kind="Sparkles" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
        <StackPanel>
          <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Strong}" FontSize="15" TextTrimming="None" TextWrapping="Wrap"/>
          <TextBlock Text="새로 바뀐 점을 알려 드릴게요." Style="{StaticResource Text.Sub}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <ScrollViewer Grid.Row="1" MaxHeight="340" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel x:Name="NotesPanel"/>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="전체 변경 기록" Style="{StaticResource Button.Outline}" Click="OpenReleases_Click" Margin="0,0,8,0"/>
        <Button Content="확인" Style="{StaticResource Button.Primary}" Click="Close_Click" MinWidth="72" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
