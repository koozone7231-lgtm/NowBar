<Window x:Class="NowBar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NowBar.App.Controls"
        xmlns:v="clr-namespace:NowBar.App.Views"
        xmlns:m="clr-namespace:NowBar.App.Models"
        Title="NowBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

  <!-- 창은 투명(클릭 통과)하고, 실제 UI는 Island 테두리 안에만 있다 -->
  <Grid>
    <!-- 캡슐 그림자: 별도 레이어로 분리해 캐시 (텍스트·글로우가 바뀔 때마다 그림자를 다시 계산하지 않도록) -->
    <Border x:Name="IslandShadow"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="{Binding ActualWidth, ElementName=Island}"
            Height="{Binding ActualHeight, ElementName=Island}"
            CornerRadius="{Binding CornerRadius, ElementName=Island}"
            Background="{DynamicResource Brush.Island}"
            IsHitTestVisible="False">
      <Border.CacheMode>
        <BitmapCache EnableClearType="False"/>
      </Border.CacheMode>
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/>
      </Border.Effect>
    </Border>

    <!-- 배경은 아래 IslandShadow 레이어가 그린다. Transparent 브러시는 마우스 히트 테스트를 위해 필요 -->
    <Border x:Name="Island"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="패널 고정" IsCheckable="True" IsChecked="{Binding IsPinned, Mode=TwoWay}"/>
          <MenuItem Header="설정..." Command="{Binding OpenSettingsCommand}"/>
          <MenuItem Header="NowBar 숨기기" Click="HideMenu_Click"/>
          <Separator/>
          <MenuItem Header="종료" Click="ExitMenu_Click"/>
        </ContextMenu>
      </Border.ContextMenu>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="TabRow" Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ClipToBounds="True">
        <!-- ── 축소 상태: 얼굴(기본) 또는 선택된 항목 하나 ── -->
        <Button x:Name="CompactPill" Style="{StaticResource Button.Bare}" Command="{Binding ExpandCommand}"
                AutomationProperties.Name="NowBar 펼치기" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Grid>
          <!-- 얼굴 모드: 눈만 있는 얼굴이 상태를 표정으로 보여준다 -->
          <c:FaceView x:Name="Face" Mood="{Binding FaceMood}" ToolTip="{Binding FaceStatusText}"
                      Visibility="{Binding IsFaceMode, Converter={StaticResource BoolToVis}}"/>
          <Grid Visibility="{Binding IsFaceMode, Converter={StaticResource InvBoolToVis}}">
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsWeatherSelected, Converter={StaticResource BoolToVis}}">
              <c:Icon Kind="{Binding Weather.IconKind}" Width="16" Height="16" Foreground="{DynamicResource Brush.Weather}" VerticalAlignment="Center"/>
              <TextBlock Text="날씨" Style="{StaticResource Text.TabName}" Margin="7,0,0,0"/>
              <TextBlock Text="{Binding Weather.CompactText}" Style="{StaticResource Text.TabStatus}" Margin="7,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMusicSelected, Converter={StaticResource BoolToVis}}">
              <c:Icon Kind="Music" Width="16" Height="16" Foreground="{DynamicResource Brush.Music}" VerticalAlignment="Center"/>
              <TextBlock Text="음악" Style="{StaticResource Text.TabName}" Margin="7,0,0,0"/>
              <TextBlock Text="{Binding Music.CompactText}" Style="{StaticResource Text.TabStatus}" Margin="7,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsAISelected, Converter={StaticResource BoolToVis}}">
              <c:Icon Kind="Sparkles" Width="16" Height="16" Foreground="{DynamicResource Brush.AI}" VerticalAlignment="Center"/>
              <TextBlock Text="AI 작업" Style="{StaticResource Text.TabName}" Margin="7,0,0,0"/>
              <TextBlock Text="{Binding AI.CompactText}" Style="{StaticResource Text.TabStatus}" Margin="7,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsToolsSelected, Converter={StaticResource BoolToVis}}">
              <c:Icon Kind="Tool" Width="16" Height="16" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
              <TextBlock Text="도구" Style="{StaticResource Text.TabName}" Margin="7,0,0,0"/>
              <TextBlock Text="빠른 설정" Style="{StaticResource Text.TabStatus}" Margin="7,0,0,0"/>
            </StackPanel>
          </Grid>
          </Grid>
        </Button>

        <!-- ── 확장 상태: 네 탭 (확장 너비로 고정 배치 후 잘라서 표시 → 애니메이션 중 흔들림 없음) ── -->
        <Grid x:Name="TabsGrid" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
          <Grid Margin="6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <!-- 도구 탭은 상태 글자가 없으므로 필요한 만큼만 차지해 나머지 탭에 공간을 준다 -->
            <ColumnDefinition Width="Auto" MinWidth="76"/>
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource Button.Tab}" BorderBrush="{DynamicResource Brush.Weather}"
                  Tag="{Binding IsWeatherSelected}" ToolTip="날씨"
                  Command="{Binding SelectTabCommand}" CommandParameter="{x:Static m:NowBarTab.Weather}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Kind="{Binding Weather.IconKind}" Width="16" Height="16" Foreground="{DynamicResource Brush.Weather}" VerticalAlignment="Center"/>
              <TextBlock Text="날씨" Style="{StaticResource Text.TabName}" Margin="6,0,0,0"/>
              <TextBlock Text="{Binding Weather.CompactText}" Style="{StaticResource Text.TabStatus}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>

          <Rectangle Grid.Column="1" Width="1" Height="18" Fill="{DynamicResource Brush.Divider}" VerticalAlignment="Center"/>

          <Button Grid.Column="2" Style="{StaticResource Button.Tab}" BorderBrush="{DynamicResource Brush.Music}"
                  Tag="{Binding IsMusicSelected}" ToolTip="음악"
                  Command="{Binding SelectTabCommand}" CommandParameter="{x:Static m:NowBarTab.Music}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Kind="Music" Width="16" Height="16" Foreground="{DynamicResource Brush.Music}" VerticalAlignment="Center"/>
              <TextBlock Text="음악" Style="{StaticResource Text.TabName}" Margin="6,0,0,0"/>
              <TextBlock Text="{Binding Music.CompactText}" Style="{StaticResource Text.TabStatus}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>

          <Rectangle Grid.Column="3" Width="1" Height="18" Fill="{DynamicResource Brush.Divider}" VerticalAlignment="Center"/>

          <Button Grid.Column="4" Style="{StaticResource Button.Tab}" BorderBrush="{DynamicResource Brush.AI}"
                  Tag="{Binding IsAISelected}" ToolTip="AI 작업 (Claude Code)"
                  Command="{Binding SelectTabCommand}" CommandParameter="{x:Static m:NowBarTab.AI}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Kind="Sparkles" Width="16" Height="16" Foreground="{DynamicResource Brush.AI}" VerticalAlignment="Center"/>
              <TextBlock Text="AI" Style="{StaticResource Text.TabName}" Margin="6,0,0,0"/>
              <TextBlock Text="{Binding AI.CompactText}" Style="{StaticResource Text.TabStatus}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>

          <Rectangle Grid.Column="5" Width="1" Height="18" Fill="{DynamicResource Brush.Divider}" VerticalAlignment="Center"/>

          <Button Grid.Column="6" Style="{StaticResource Button.Tab}"
                  Tag="{Binding IsToolsSelected}" ToolTip="도구 (빠른 설정 · 볼륨 믹서)" AutomationProperties.Name="도구"
                  Command="{Binding SelectTabCommand}" CommandParameter="{x:Static m:NowBarTab.Tools}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Kind="Tool" Width="16" Height="16" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
              <TextBlock Text="도구" Style="{StaticResource Text.TabName}" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          </Grid>
        </Grid>
        </Grid>

        <!-- ── 확장 패널: 고정 크기 콘텐츠를 잘라서 보여주므로 애니메이션 중 레이아웃이 흔들리지 않는다 ── -->
        <Grid Grid.Row="1" ClipToBounds="True">
          <Grid x:Name="DetailHost" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
            <Rectangle Height="1" VerticalAlignment="Top" Margin="18,0" Fill="{DynamicResource Brush.Divider}"/>

            <!-- 탭 내용 (설정이 열려 있으면 숨김) -->
            <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource InvBoolToVis}}">
              <Grid Visibility="{Binding IsWeatherSelected, Converter={StaticResource BoolToVis}}">
                <v:WeatherView DataContext="{Binding Weather}"/>
              </Grid>
              <Grid Visibility="{Binding IsMusicSelected, Converter={StaticResource BoolToVis}}">
                <v:MusicView DataContext="{Binding Music}"/>
              </Grid>
              <Grid Visibility="{Binding IsAISelected, Converter={StaticResource BoolToVis}}">
                <v:AIActivityView DataContext="{Binding AI}"/>
              </Grid>
              <Grid Visibility="{Binding IsToolsSelected, Converter={StaticResource BoolToVis}}">
                <v:ToolsView DataContext="{Binding Tools}"/>
              </Grid>
            </Grid>

            <!-- 설정: 패널이 커지며 이 자리에 열린다 -->
            <v:SettingsView DataContext="{Binding SettingsPanel}"
                            Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

            <!-- 오른쪽 위: 고정 / 설정 (설정 화면에서는 헤더에 자체 버튼이 있으므로 숨김) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource InvBoolToVis}}">
              <!-- 배터리·네트워크: 작게, 문제 있을 때만 경고색 -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" DataContext="{Binding Status}"
                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <c:NetworkGlyph Kind="{Binding Network}" Bars="{Binding WifiBars}" ToolTip="{Binding NetworkTooltip}"
                                VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding BatteryTooltip}"
                            Background="Transparent" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                  <c:BatteryGlyph Level="{Binding BatteryPercent}" IsCharging="{Binding IsCharging}" IsLow="{Binding IsBatteryLow}"
                                  VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding BatteryText}" Margin="4,0,0,0" FontSize="11.5">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </StackPanel>
              <Button Style="{StaticResource Button.Icon}" Command="{Binding TogglePinCommand}" ToolTip="패널 고정 (ESC: 고정 해제)" AutomationProperties.Name="패널 고정">
                <c:Icon Kind="Pin" Width="16" Height="16">
                  <c:Icon.Style>
                    <Style TargetType="c:Icon">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                          <Setter Property="Filled" Value="True"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </c:Icon.Style>
                </c:Icon>
              </Button>
              <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenSettingsCommand}" ToolTip="설정" AutomationProperties.Name="설정" Margin="2,0,0,0">
                <Grid Width="18" Height="18">
                  <c:Icon Kind="Settings" Width="16" Height="16" Foreground="{DynamicResource Brush.SubText}"/>
                  <!-- 새 버전이 있으면 작은 점 -->
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Claude 작업 중 테두리 글로우: 캡슐과 같은 위치·크기·모서리로 겹쳐 그린다 (마우스 이벤트는 통과) -->
    <Border x:Name="WorkingGlow"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="{Binding ActualWidth, ElementName=Island}"
            Height="{Binding ActualHeight, ElementName=Island}"
            CornerRadius="{Binding CornerRadius, ElementName=Island}"
            BorderBrush="{DynamicResource Brush.Accent}"
            BorderThickness="2"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
      <!-- 효과(블러/그림자)를 한 번만 그려 캐시 → 깜빡임 애니메이션은 투명도만 바뀌므로 CPU 부담이 작다 -->
      <Border.CacheMode>
        <BitmapCache EnableClearType="False" SnapsToDevicePixels="True"/>
      </Border.CacheMode>
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="1"
                          Color="{Binding BorderBrush.Color, ElementName=WorkingGlow}"/>
      </Border.Effect>
      <!-- 안쪽 은은한 광택 (테두리 안쪽 가장자리에 색을 살짝 번지게) -->
      <Border CornerRadius="{Binding CornerRadius, ElementName=Island}" BorderThickness="3" Margin="-1" Opacity="0.35"
              BorderBrush="{DynamicResource Brush.Accent}">
        <Border.Effect>
          <BlurEffect Radius="6"/>
        </Border.Effect>
      </Border>
    </Border>
  </Grid>
</Window>
